# Required only for the AI revision feature.
OPENAI_API_KEY=
# Override if your provider account uses a different available model.
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Use your deployed frontend origin in production, e.g. https://textlens.vercel.app
# Comma-separated origins are supported. '*' is convenient for local development only.
TEXTLENS_CORS_ORIGINS=http://localhost:3000
